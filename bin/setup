#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

ruby=$(ruby -e 'print RUBY_VERSION')
[[ $ruby == "$(<.ruby-version)" ]] || { echo "Ruby $(<.ruby-version) required, found $ruby" >&2; exit 1; }

redmine=tmp/redmine

[[ -d $redmine ]] || git clone --depth 1 --branch "${REDMINE_VERSION:-7.0-stable}" https://github.com/redmine/redmine.git $redmine
ln -sfn ../../.. $redmine/plugins/redmine_tracky

db=config/database.yml.example
[[ -v GITHUB_ACTIONS ]] && db=.github/database.yml
[[ -f $redmine/config/database.yml ]] || cp $db $redmine/config/database.yml

cd assets.src
npm install
npm run build
cd ../$redmine

bundle config set --local path ../bundle
bundle install -j 4
bin/rails db:create db:migrate redmine:plugins:redmine_tracky:install
REDMINE_LANG=en bin/rails redmine:load_default_data
if bin/rails runner 'exit Project.none?'; then
  bin/rails redmine:sample_data:seed
fi
